# Copy to .env. Mock mode needs no GoHighLevel account.
# The encryption key below is for the mock only. Live mode refuses to boot with it.

GHL_MODE=mock
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CONSOLE_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://ghl:ghl@localhost:5432/ghl
QUEUE_DB_PATH=./data/queue.sqlite

# 32-byte demo key, base64. Generate your own before pointing this at a real account:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=ZGVtby1vbmx5LWtleS1ub3QtZm9yLWxpdmUtdXNlISE=

# Mock (default). Compose points GHL_BASE_URL at the mock-ghl service.
GHL_BASE_URL=http://localhost:4100
GHL_OAUTH_AUTHORIZE_URL=http://localhost:4100/oauth/chooselocation
GHL_CLIENT_ID=mock-client-id
GHL_CLIENT_SECRET=mock-client-secret
GHL_REDIRECT_URI=http://localhost:4000/oauth/callback
GHL_USER_TYPE=Location

# Live mode: set GHL_MODE=live and replace the block above with your marketplace app.
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_OAUTH_AUTHORIZE_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
# GHL_CLIENT_ID=
# GHL_CLIENT_SECRET=
# GHL_REDIRECT_URI=https://your-host.example/oauth/callback
# Optional PEM overrides. Otherwise live mode uses the public keys from the webhook guide.
# GHL_ED25519_PUBLIC_KEY=
# GHL_RSA_PUBLIC_KEY=

META_VERIFY_TOKEN=mock-meta-verify
META_APP_SECRET=mock-meta-secret
FORM_WEBHOOK_SECRET=mock-form-secret

BUSINESS_NAME=Northwind Studio
LOCATION_ID=loc_northwind_555
PIPELINE_ID=pipe_new_leads
PIPELINE_STAGE_NEW=stage_new
PIPELINE_STAGE_BOOKED=stage_booked
CALENDAR_ID=cal_intro
TIMEZONE=America/New_York

WEBHOOK_TIMESTAMP_WINDOW_MS=300000
TOKEN_REFRESH_SKEW_MS=300000
OAUTH_STATE_TTL_MS=600000
QUEUE_MAX_ATTEMPTS=5
QUEUE_BASE_BACKOFF_MS=500
QUEUE_MAX_BACKOFF_MS=30000
QUEUE_JITTER_RATIO=0.2
QUEUE_POLL_MS=200

FIELD_MAP_PATH=config/field-map.json
CUSTOM_FIELD_IDS_PATH=config/custom-field-ids.json
NEXT_PUBLIC_API_BASE=http://localhost:4000
